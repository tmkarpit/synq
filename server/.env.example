# SYNQ server environment. Copy to .env (loaded by npm run dev / start).

# MongoDB: rooms, files and accounts. Local server: mongodb://localhost:27017/synq
# (open the same address in MongoDB Compass). Leave empty to keep rooms as files in
# server/data (no accounts then).
MONGODB_URI=mongodb://localhost:27017/synq

# Signs the login tokens (JWT, HS256). Required with MONGODB_URI. Use 32+ random
# characters, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs everyone out.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-characters

# ---- Verification codes and Google sign-in -------------------------------------------
# Email codes: any SMTP server. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=you@gmail.com, SMTP_PASS=<16-character app password from your Google account>.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# SMS codes: Twilio (console.twilio.com). TWILIO_FROM is your Twilio phone number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Numbers typed without +country use this code (91 = India).
DEFAULT_COUNTRY_CODE=91
# "Continue with Google": OAuth client id (Google Cloud Console > APIs & Services >
# Credentials > OAuth client ID > Web application; add http://localhost:5173 as an
# authorized JavaScript origin).
GOOGLE_CLIENT_ID=
# Development only: print codes that cannot be sent (no SMTP/Twilio yet) in the server log.
OTP_DEV_LOG=false

# Used by "npm run test:db" (a throwaway database; it is dropped and recreated).
TEST_MONGODB_URI=mongodb://localhost:27017/synq_test
