# SYNQ server environment. Copy to .env (loaded by npm run dev / start).

# MongoDB: rooms, files and accounts. Local server: mongodb://localhost:27017/synq
# (open the same address in MongoDB Compass). Leave empty to keep rooms as files in
# server/data (no accounts then).
MONGODB_URI=mongodb://localhost:27017/synq
# 4 = reach the database over IPv4 only (helps when Atlas blocks a mobile network's IPv6
# route even though your IP is allowed).
# MONGODB_IP_FAMILY=4

# Signs the login tokens (JWT, HS256). Required with MONGODB_URI. Use 32+ random
# characters, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs everyone out.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-characters

# ---- Verification codes and Google sign-in -------------------------------------------
# Email codes: any SMTP server. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=you@gmail.com, SMTP_PASS=<16-character app password from your Google account>.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# SMS codes: Twilio (console.twilio.com). TWILIO_FROM is your Twilio phone number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Numbers typed without +country use this code (91 = India).
DEFAULT_COUNTRY_CODE=91
# "Continue with Google": OAuth client id (Google Cloud Console > APIs & Services >
# Credentials > OAuth client ID > Web application; add http://localhost:5173 as an
# authorized JavaScript origin).
GOOGLE_CLIENT_ID=
# Development only: print codes that cannot be sent (no SMTP/Twilio yet) in the server log.
OTP_DEV_LOG=false

# Used by "npm run test:db" (a throwaway database; it is dropped and recreated).
TEST_MONGODB_URI=mongodb://localhost:27017/synq_test

# ---- Server and production ------------------------------------------------------------
# Lines starting with "# " are optional: uncomment to set them (left empty they would
# override the Docker image defaults).
# NODE_ENV=production switches to safe defaults: the host terminal and Python/C/C++/Java
# are off (SHELL_ENABLED / RUN_LANGUAGES turn them back on), sockets are same-origin only
# (CORS_ORIGIN), and the health endpoint reveals nothing.
# NODE_ENV=production
# PORT=4000
# HOST=0.0.0.0
# Serve the built client (client/dist) from this server: site, API, sockets and Go Live
# on one origin. Recommended for deploys (the Dockerfile sets it).
# STATIC_DIR=
# Comma-separated origins allowed to open sockets when the site is hosted elsewhere.
# CORS_ORIGIN=
# Set to true when the site is served over HTTPS (secure login cookie).
COOKIE_SECURE=false
# Number of proxies in front of the server (load balancer = 1, CDN + load balancer = 2),
# so rate limits use the visitor's address instead of the proxy's.
TRUST_PROXY=0

# ---- Code execution and terminal ------------------------------------------------------
# Python, C, C++ and Java run WITHOUT a sandbox (the server user's permissions); the
# terminal runs real shell commands. Only enable them for trusted users or in a container.
RUN_ENABLED=true
# e.g. javascript,typescript (default: all installed in development, JS/TS in production)
# RUN_LANGUAGES=
# SHELL_ENABLED=
# Where rooms are kept without MongoDB, and each room's terminal folder.
# DATA_DIR=
# WORKSPACES_DIR=
