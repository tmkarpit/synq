# SYNQ server settings. Copy to .env for local use (npm run dev / npm start); on Render,
# enter them under Environment. Placeholders only: never commit real values.
# Lines starting with "# NAME=" are optional; uncomment to set them.

# ---- Database ----------------------------------------------------------------------------
# MongoDB: rooms, files and accounts. Local: mongodb://localhost:27017/synq
# Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/synq?retryWrites=true&w=majority
# (URL-encode special characters in the password, e.g. @ -> %40, # -> %23.)
MONGODB_URI=mongodb://localhost:27017/synq
# 4 = reach the database over IPv4 only (some mobile networks route IPv6 through another
# address that the Atlas IP access list blocks).
# MONGODB_IP_FAMILY=4
# Used by "npm run test:db" (a throwaway database; it is dropped and recreated).
TEST_MONGODB_URI=mongodb://localhost:27017/synq_test

# ---- Logins ------------------------------------------------------------------------------
# Signs login tokens: 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs everyone out.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-characters
# true when the site is served over HTTPS (always on Render/Vercel).
COOKIE_SECURE=false
# lax (default) when the site and /api share an origin (one service, or Vercel's /api
# rewrite). none only if the site calls the API on another domain directly (needs HTTPS;
# browsers that block third-party cookies will log people out on reload).
# COOKIE_SAMESITE=lax
# "Continue with Google": OAuth client id (Google Cloud Console > APIs & Services >
# Credentials > OAuth client ID > Web application; add your site as an authorized origin).
GOOGLE_CLIENT_ID=

# ---- Verification codes ------------------------------------------------------------------
# Email codes over SMTP. Gmail: smtp.gmail.com, port 465, your address, and a 16-character
# app password (https://myaccount.google.com/apppasswords), not your normal password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# The sender shown in the email, e.g. SYNQ <you@gmail.com>
MAIL_FROM=
# SMS codes through Twilio (console.twilio.com); leave empty to turn SMS off.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Phone numbers typed without +country get this code (91 = India).
DEFAULT_COUNTRY_CODE=91
# Development only: print codes that cannot be sent in the server log. false in production.
OTP_DEV_LOG=false

# ---- Server and browsers -----------------------------------------------------------------
# production switches to safe defaults: running code and the terminal off unless enabled
# below, requests and sockets only from CLIENT_ORIGINS (or the same origin).
# NODE_ENV=production
# Port and address to listen on (Render sets PORT itself).
# PORT=4000
# HOST=0.0.0.0
# Sites allowed to use the API and open sockets, comma separated, https, no trailing
# slash, e.g. https://synq.vercel.app,https://synq.example.com
# CLIENT_ORIGINS=
# Also allow this Vercel project's preview deployments (https://<name>-<hash>.vercel.app).
# VERCEL_PREVIEW_PROJECT=
# Proxies in front of the server, so rate limits see each visitor's real address:
# Render alone = 1; Vercel's /api rewrite in front of Render = 2.
TRUST_PROXY=0
# Serve the built client (client/dist) from this server: one origin for everything
# (Docker / single-service deploys). Found by itself in production after a build.
# STATIC_DIR=

# ---- Running code and terminal -----------------------------------------------------------
# Off by default in production. true to let people run code (time, memory and output
# limits always apply).
# RUN_ENABLED=true
# Allowed languages, comma separated. Default: all installed in development, only the
# sandboxed javascript,typescript in production. python, c, cpp and java run WITHOUT a
# sandbox (the server user's permissions): only enable them in a container you trust.
# RUN_LANGUAGES=javascript,typescript
# Python, C, C++ and Java on JDoodle instead of this server (safe for public sites). Free
# plan, no card, about 20 runs a day: https://www.jdoodle.com/compiler-api > Client ID and
# Client Secret. Empty = off.
# JDOODLE_CLIENT_ID=
# JDOODLE_CLIENT_SECRET=
# Optional: languages (default python,c,cpp,java) and version indexes if JDoodle changes them.
# JDOODLE_LANGUAGES=python,c,cpp,java
# JDOODLE_VERSIONS=python:4,c:5,cpp:1,java:4
# Or Judge0 (paid plans / card on RapidAPI) for Python, C, C++ and Java (safe for public
# sites). Key from RapidAPI > Judge0 CE (free plan has a daily limit). Empty = off.
# If you turn it on, add Judge0 to the privacy page (client/src/features/legal).
# JUDGE0_API_KEY=
# Self-hosted Judge0 instead of RapidAPI (the key is then sent as X-Auth-Token).
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# Which languages go to Judge0 (default python,c,cpp,java).
# JUDGE0_LANGUAGES=python,c,cpp,java
# The room terminal runs real shell commands on the server. Off in production by default.
# SHELL_ENABLED=false
# Where rooms are kept without MongoDB, and each room's terminal folder.
# DATA_DIR=
# WORKSPACES_DIR=
