# SYNQ client environment. Copy to .env.local and adjust.
# Vite only exposes variables that start with VITE_.

# false -> real collaboration through the SYNQ server (server/). Invite links work for
#          anyone who can reach this machine. Start it with: npm run dev:server
# true  -> offline mock collaboration (tabs of one browser only, no server needed)
VITE_USE_MOCK=false

# Backend URLs (live mode). Leave empty to use this page's origin: the Vite dev server
# proxies /socket.io and /api to http://localhost:4000 (override with SYNQ_SERVER_URL).
VITE_SOCKET_URL=
VITE_API_URL=
