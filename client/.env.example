# SYNQ client settings. Copy to .env.local for local use; on Vercel, enter them under
# Settings > Environment Variables (and redeploy after every change: Vite bakes them into
# the build). Vite only exposes variables that start with VITE_.

# false = the real app (talks to the SYNQ server). true = offline demo with simulated
# teammates (no server). Default: true in development, false in production builds.
VITE_USE_MOCK=false

# The SYNQ server for live editing (Socket.IO) and Go Live previews. Empty = this page's
# origin (local dev: Vite proxies to http://localhost:4000, or SYNQ_SERVER_URL).
# On Vercel: your Render URL, e.g. https://synq-server.onrender.com (no trailing slash).
VITE_SOCKET_URL=

# The SYNQ API (login, rooms). Empty = this page's origin. Leave it EMPTY on Vercel:
# vercel.json passes /api to Render, which keeps the login cookie first-party.
VITE_API_URL=

# Public address of the site, for SEO (canonical link, preview image, sitemap.xml), e.g.
# https://synq.vercel.app (no trailing slash). Read from the build environment (Vercel
# variables, or the shell: SITE_URL=... npm run build), not from this file.
# SITE_URL=
